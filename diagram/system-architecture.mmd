end

%% Backend Section
subgraph "Business Layer"
AuthModule --> AuthService[Auth Service]
UserModule --> UserService[User Service]
BoardModule --> BoardService[Board Service]
end

%% Database Layer
subgraph "Data Layer"
AuthService --> PrismaORM[Prisma ORM]
